ORCHESTRATOR_PUBLIC_URL=http://localhost:8000
# Публичный HTTPS-адрес, если через туннель доступен только callback YouGile.
# ORCHESTRATOR_TRACKER_WEBHOOK_PUBLIC_URL=https://orchestrator.example.com
ORCHESTRATOR_WORKER_TOKEN=replace-with-a-long-random-token
ORCHESTRATOR_GIT_WEBHOOK_SECRET=replace-with-github-webhook-secret
ORCHESTRATOR_TRACKER_WEBHOOK_SECRET=replace-with-tracker-webhook-secret
ORCHESTRATOR_AUTO_START=true
